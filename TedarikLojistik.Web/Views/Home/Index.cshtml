@model TedarikLojistik.Web.Models.Entities.Order

@{
    ViewData["Title"] = "Sistem Test Ekranı";
}

<div class="container mt-5">
    <div class="text-center mb-5">
        <h2 class="text-success fw-bold">@ViewBag.Message</h2>
        <p class="text-muted">OOP Prensipleri ve 7 Tasarım Deseni kullanılarak oluşturulan sipariş akışı.</p>
    </div>
    
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow border-0 rounded-3">
                <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center">
                    <span class="fs-5">Sipariş Özeti</span>
                    <span class="badge bg-warning text-dark fs-6">@Model.SiparisNo</span>
                </div>
                <div class="card-body bg-light">
                    
                    <div class="row mb-3 border-bottom pb-2">
                        <div class="col-sm-4 fw-bold text-secondary">State Pattern (Durum)</div>
                        <div class="col-sm-8"><span class="badge bg-primary fs-6">@Model.Durum.ToString()</span></div>
                    </div>

                    <div class="row mb-3 border-bottom pb-2">
                        <div class="col-sm-4 fw-bold text-secondary">Strategy Pattern (Ödeme)</div>
                        <div class="col-sm-8">
                            @Model.OdemeYontemi 
                            @if(Model.OdemeTamamlandi) { <span class="text-success ms-2"><i class="bi bi-check-circle-fill"></i> Başarılı</span> }
                        </div>
                    </div>

                    <div class="row mb-3 border-bottom pb-2">
                        <div class="col-sm-4 fw-bold text-secondary">Sipariş Tutarı</div>
                        <div class="col-sm-8 text-dark">@Model.UrunToplami.ToString("C")</div>
                    </div>

                    <div class="row mb-3 border-bottom pb-2">
                        <div class="col-sm-4 fw-bold text-secondary">Decorator Pattern (Kargo Ücreti)</div>
                        <div class="col-sm-8 text-danger">
                            +@Model.KargoUcreti.ToString("C")
                            <br><small class="text-muted">(Standart + Sigorta + Kırılacak Eşya eklemeleri)</small>
                        </div>
                    </div>

                    <div class="row mb-3 border-bottom pb-2">
                        <div class="col-sm-4 fw-bold text-secondary">Genel Toplam</div>
                        <div class="col-sm-8 fs-5 fw-bold text-success">@Model.ToplamTutar.ToString("C")</div>
                    </div>

                    <div class="row mb-2">
                        <div class="col-sm-4 fw-bold text-secondary">Adapter Pattern (Kargo API)</div>
                        <div class="col-sm-8">
                            Seçilen: @Model.KargoFirmasi <br/>
                            Takip No: <strong>@ViewBag.TrackingNo</strong>
                        </div>
                    </div>

                </div>
                <div class="card-footer text-center text-muted small">
                    * Ayrıca arkaplanda <b>Singleton</b> deseni ile loglama yapılmakta ve <b>Observer</b> ile stok yönetimi dinlenmektedir.
                </div>
            </div>
        </div>
    </div>
</div>

