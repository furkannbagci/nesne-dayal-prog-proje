@{ ViewData["Title"] = "Kayıt Ol"; }

<section class="login-shell">
    <div class="login-panel app-card">
        <div class="login-brand">
            <div class="brand-mark"><i class="bi bi-person-plus"></i></div>
            <div>
                <p class="eyebrow">Müşteri Kaydı</p>
                <h1>Kayıt ol</h1>
            </div>
        </div>

        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger app-alert">@TempData["Error"]</div>
        }

        <form asp-action="Register" method="post" class="login-form">
            <label class="form-label" for="fullName">Ad Soyad</label>
            <input id="fullName" name="fullName" class="form-control" required />

            <label class="form-label" for="email">E-posta</label>
            <input id="email" name="email" type="email" class="form-control" autocomplete="username" required />

            <label class="form-label" for="password">Şifre</label>
            <input id="password" name="password" type="password" class="form-control" autocomplete="new-password" minlength="3" required />

            <button type="submit" class="btn btn-primary w-100">Kayıt Ol</button>
        </form>

        <div class="auth-link">
            Zaten hesabınız var mı? <a asp-controller="Account" asp-action="Login">Giriş yapın</a>
        </div>
    </div>
</section>
